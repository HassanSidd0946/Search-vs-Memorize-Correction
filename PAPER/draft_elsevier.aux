\def\@LN@column{1}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces D2 parity-split replication: pre-calibration balanced accuracy for odd (Search-first, n=14, 0.6205) and even (Memorize-first, n=15, 0.5582) subject subgroups against each subgroup's own within-group shuffled-label null (modeled from N(mean, SD); per-shuffle values not stored). Both subgroups clear their own 95\% CI. The gap above null is asymmetric: 0.1162 (odd) vs. 0.0597 (even), roughly 2$\times $, unresolved (\S  \ref {sec:limitations}).}}{14}{figure.4}\protected@file@percent }
\newlabel{fig:4}{{4}{14}{D2 parity-split replication: pre-calibration balanced accuracy for odd (Search-first, n=14, 0.6205) and even (Memorize-first, n=15, 0.5582) subject subgroups against each subgroup's own within-group shuffled-label null (modeled from N(mean, SD); per-shuffle values not stored). Both subgroups clear their own 95\% CI. The gap above null is asymmetric: 0.1162 (odd) vs. 0.0597 (even), roughly 2$\times $, unresolved (\S \ref {sec:limitations})}{figure.4}{}}
