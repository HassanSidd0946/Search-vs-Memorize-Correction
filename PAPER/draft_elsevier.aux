\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Leave-one-subject-out jackknife: the 29 leave-one-out mean pre-calibration balanced accuracies obtained by excluding each subject from R2 in turn (see Supplementary Table S1). Reference lines mark the full-sample mean (0.5737), the null 95\% CI upper bound (0.5223), and the C4 null mean (0.4994). No exclusion drops the mean below 0.5223; the extremes are sub-03 (highest, 0.5815) and sub-18 (lowest, 0.5674).}}{11}{figure.2}\protected@file@percent }
\newlabel{fig:2}{{2}{11}{Leave-one-subject-out jackknife: the 29 leave-one-out mean pre-calibration balanced accuracies obtained by excluding each subject from R2 in turn (see Supplementary Table S1). Reference lines mark the full-sample mean (0.5737), the null 95\% CI upper bound (0.5223), and the C4 null mean (0.4994). No exclusion drops the mean below 0.5223; the extremes are sub-03 (highest, 0.5815) and sub-18 (lowest, 0.5674)}{figure.2}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {3.6.3}C4 --- Higher-resolution shuffled-label null}{11}{subsubsection.3.6.3}\protected@file@percent }
\citation{greenwald1976}
\def\@LN@column{1}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces R2's pre-calibration balanced accuracy (0.5737) against two shuffled-label null distributions computed on the exact R2 dataset: C1 (30 shuffles, mean 0.5010, SD 0.0137) and C4 (500 shuffles, mean 0.4994, SD 0.0108, p = 0.0020 add-one-corrected). Null densities are modeled from N(mean, SD); per-shuffle values are not stored in the ledger. R2 falls $\sim $7.3--7.4 percentage points above both.}}{12}{figure.3}\protected@file@percent }
\newlabel{fig:3}{{3}{12}{R2's pre-calibration balanced accuracy (0.5737) against two shuffled-label null distributions computed on the exact R2 dataset: C1 (30 shuffles, mean 0.5010, SD 0.0137) and C4 (500 shuffles, mean 0.4994, SD 0.0108, p = 0.0020 add-one-corrected). Null densities are modeled from N(mean, SD); per-shuffle values are not stored in the ledger. R2 falls $\sim $7.3--7.4 percentage points above both}{figure.3}{}}
