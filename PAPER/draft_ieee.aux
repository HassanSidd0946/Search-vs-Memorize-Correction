\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces D2 parity-split replication: pre-calibration balanced accuracy for odd (Search-first, n=14, 0.6157 $\pm $ 0.001) and even (Memorize-first, n=15, 0.5582 $\pm $ 0.001) subject subgroups against each subgroup's own within-group shuffled-label null (empirical, the real 30 per-shuffle values from each subgroup's own committed run record). Both subgroups clear their own 95\% CI. The gap above each subgroup's null mean is asymmetric: 0.1170 $\pm $ 0.001 (odd) vs. 0.0597 $\pm $ 0.001 (even), roughly 2$\times $, unresolved (\S  \ref {sec:limitations}).}}{7}{figure.4}\protected@file@percent }
\newlabel{fig:4}{{4}{7}{D2 parity-split replication: pre-calibration balanced accuracy for odd (Search-first, n=14, 0.6157 $\pm $ 0.001) and even (Memorize-first, n=15, 0.5582 $\pm $ 0.001) subject subgroups against each subgroup's own within-group shuffled-label null (empirical, the real 30 per-shuffle values from each subgroup's own committed run record). Both subgroups clear their own 95\% CI. The gap above each subgroup's null mean is asymmetric: 0.1170 $\pm $ 0.001 (odd) vs. 0.0597 $\pm $ 0.001 (even), roughly 2$\times $, unresolved (\S \ref {sec:limitations})}{figure.4}{}}
