venv/
data/
__pycache__/
*.pyc

# LaTeX compile byproducts (regenerated by every pdflatex/bibtex run;
# never authoritative content). Manuscript PDFs (draft_elsevier.pdf,
# draft_ieee.pdf) and figure outputs (PAPER/figures/*.pdf, *.png) are
# deliberately tracked and NOT covered by any rule below.
*.aux
*.log
*.out
*.bbl
*.blg
*.fls
*.fdb_latexmk
*.synctex.gz
*.spl
*.toc

# -jobname intermediates from the WPS-lock compile workaround
# (GATE D/E/F/A1/A2); PAPER/build.ps1 also cleans these up itself.
build_elsevier.*
build_ieee.*